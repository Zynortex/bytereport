# ByteReport web app — environment variables.
# Locally: copy to .env and fill in. On Vercel: Project → Settings →
# Environment Variables (they are baked in at build time: redeploy after a change).
# Never commit a filled-in .env.

# Backend base URL, no trailing slash.
# Locally: http://localhost:8000. On Vercel: the Render service URL,
# e.g. https://bytereport-api.onrender.com
VITE_API_URL=

# Supabase → Project Settings → API.
# Project URL, https://<ref>.supabase.co
VITE_SUPABASE_URL=
# The anon / publishable key only. Never the service_role key: everything in
# a VITE_ variable ends up in the public JavaScript bundle.
VITE_SUPABASE_ANON_KEY=

# Public address of the site, used for og:image / og:url in the shared demo
# link. Optional; defaults to https://bytereport-frontend.vercel.app
VITE_SITE_URL=
