# ByteReport API — environment variables.
# Locally: copy to .env and fill in. On Render: Service → Environment.
# Commented lines have a working default in app/core/config.py; uncomment only
# to change it. Never commit a filled-in .env.

# ── Run without an AI key ────────────────────────────────────────────────────
# 1 = every AI answer (report, chat, note, photo, voice) comes from
# app/fixtures/ai_mock.json: no OpenAI request, no key, no cost. The texts say
# "AI_MOCK=1", so a mocked report is never mistaken for a real one.
# Local runs and demos without a key: 1. Production: leave empty.
AI_MOCK=

# ── Supabase: project dashboard → Project Settings → API ─────────────────────
# Project URL, https://<ref>.supabase.co
SUPABASE_URL=
# The anon / publishable key (safe for a browser; the frontend uses the same one).
SUPABASE_ANON_KEY=
# The service_role / secret key. Charges and refunds report credits and runs
# /health/deep. Server only: never in the frontend, never in git.
SUPABASE_SERVICE_KEY=
# Only for a legacy HS256 project (Settings → API → JWT secret). Normally empty:
# tokens are checked against the project's public JWKS.
# SUPABASE_JWT_SECRET=

# ── AI provider ──────────────────────────────────────────────────────────────
# openai | anthropic (default openai)
# AI_PROVIDER=
# platform.openai.com → the bytereport-prod project → API keys. Not needed with AI_MOCK=1.
OPENAI_API_KEY=
# Reasoning model for the report and chat (default gpt-4.1).
# OPENAI_MODEL=
# Speech-to-text for voice notes (default gpt-4o-transcribe).
# TRANSCRIPTION_MODEL=
# Reads photographed receipts (default gpt-4o).
# VISION_MODEL=
# console.anthropic.com → API keys. Only with AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# Hard ceiling on one provider call, seconds (default 120).
# AI_TIMEOUT_SECONDS=

# ── Web app (CORS) ───────────────────────────────────────────────────────────
# development (default) | production. In development a web app on any
# localhost / 127.0.0.1 port may call the API. On Render: production
# (render.yaml sets it), and then only ALLOWED_ORIGINS count.
# ENVIRONMENT=
# Origins allowed to call this API, comma-separated, exactly as the browser
# shows them: scheme + host, no trailing slash. E.g. https://bytereport.vercel.app
ALLOWED_ORIGINS=

# ── Access and limits ────────────────────────────────────────────────────────
# Require a signed-in user on the AI endpoints (default true).
# AUTH_REQUIRED=
# REQUIRE_EMAIL_VERIFICATION=
# BLOCK_DISPOSABLE_EMAIL=
# supabase | memory (memory = tests/local only; balances vanish on restart)
# CREDITS_STORE=
# Your own accounts, comma-separated: never charged, never run out.
UNLIMITED_REPORT_EMAILS=
# REPORT_DAILY_CAP=
# RATE_LIMIT_REPORT_PER_HOUR=
# RATE_LIMIT_AI_PER_HOUR=

# ── Misc ─────────────────────────────────────────────────────────────────────
# APP_NAME=
# DEBUG=
# UPLOAD_DIR=
# MAX_UPLOAD_SIZE_MB=
